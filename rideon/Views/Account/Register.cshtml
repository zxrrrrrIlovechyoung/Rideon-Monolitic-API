@model rideon.Models.RegistroViewModel
@{
    ViewData["Title"] = "Registro - RideOn";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .registro-container {
            background-color: #fff;
            border-radius: 16px;
            padding: 2rem;
            max-width: 400px;
            margin: 2rem auto;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        }

        .registro-logo {
            font-size: 2rem;
            font-weight: bold;
            text-align: center;
        }

        .registro-subtitle {
            font-size: 1rem;
            text-align: center;
            color: #666;
        }

        .registro-bienvenida {
            font-size: 1.2rem;
            text-align: center;
            margin-bottom: 1rem;
            color: #333;
        }

        .registro-input {
            padding: 0.75rem;
            border-radius: 10px;
            border: 1px solid #ccc;
        }

        .btn-gradient {
            padding: 0.75rem;
            background: linear-gradient(to right, #7DF1EF, #48D8D5);
            color: #fff;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.3s ease;
        }

            .btn-gradient:hover {
                background: linear-gradient(to right, #48D8D5, #7DF1EF);
            }

        .registro-nota {
            font-size: 0.85rem;
            color: #555;
        }

     

        .registro-logo {
            font-size: 1.5rem;
        }

        .registro-bienvenida {
            font-size: 1rem;
        }

        }
    </style>
</head>
<body>
    <div class="registro-container">
        <h1 class="registro-logo">RideOn</h1>
        <p class="registro-subtitle">Más que una moto, un sentimiento</p>
        <h2 class="registro-bienvenida">Bienvenido</h2>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["Mensaje"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger text-center">
                @TempData["Error"]
            </div>
        }

        <form asp-action="Register" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="strNombre" placeholder="Tu nombre/Nickname" class="form-control registro-input mb-2" />
            <span asp-validation-for="strNombre" class="text-danger"></span>

            <input asp-for="strApellidoPaterno" placeholder="Apellido paterno" class="form-control registro-input mb-2" />
            <span asp-validation-for="strApellidoPaterno" class="text-danger"></span>

            <input asp-for="strApellidoMaterno" placeholder="Apellido materno" class="form-control registro-input mb-2" />
            <span asp-validation-for="strApellidoMaterno" class="text-danger"></span>

            <input asp-for="FechaNacimiento" type="date" class="form-control registro-input mb-2" />
            <span asp-validation-for="FechaNacimiento" class="text-danger"></span>

            <select asp-for="idSexo" class="form-select registro-input mb-2" asp-items="ViewBag.idSexo">
                <option value="">Selecciona tu sexo</option>
            </select>
            <span asp-validation-for="idSexo" class="text-danger"></span>

            <input asp-for="strCorreo" type="email" placeholder="Correo" class="form-control registro-input mb-2" />
            <span asp-validation-for="strCorreo" class="text-danger"></span>

            <input asp-for="strContrasena" type="password" placeholder="Contraseña" class="form-control registro-input mb-2" id="password" />
            <span asp-validation-for="strContrasena" class="text-danger"></span>

            <input asp-for="ConfirmarContrasena" type="password" placeholder="Confirmar contraseña" class="form-control registro-input mb-2" id="confirm-password" />
            <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>

            <p id="password-match" class="text-center fw-bold mt-1"></p>

            <div class="registro-nota mb-2">
                <p>Tu contraseña debe incluir:</p>
                <ul>
                    <li>Entre 6 y 18 caracteres</li>
                    <li>Al menos una letra</li>
                    <li>Al menos un número</li>
                    <li>Al menos un carácter especial</li>
                </ul>
            </div>

            <button type="submit" class="btn-gradient w-100">Crear cuenta</button>
        </form>

        <p class="text-center mt-3">
            ¿Ya tienes cuenta? <a asp-controller="Account" asp-action="Login">Inicia sesión</a>
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        const password = document.getElementById("password");
        const confirmPassword = document.getElementById("confirm-password");
        const matchMessage = document.getElementById("password-match");

        function checkPasswordMatch() {
            if (confirmPassword.value === "") {
                matchMessage.textContent = "";
                return;
            }

            if (password.value === confirmPassword.value) {
                matchMessage.textContent = "¡Las contraseñas coinciden!";
                matchMessage.style.color = "green";
            } else {
                matchMessage.textContent = "Las contraseñas no coinciden.";
                matchMessage.style.color = "red";
            }
        }

        password.addEventListener("input", checkPasswordMatch);
        confirmPassword.addEventListener("input", checkPasswordMatch);
    </script>
</body>
</html>
