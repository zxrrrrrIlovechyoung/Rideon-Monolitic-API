@{
    ViewData["Title"] = "Verificar correo";
}
<h2>Verificación de correo</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="VerificarRegistro" method="post">
    <input type="hidden" name="correo" value="@ViewBag.Correo" />

    <div class="mb-3">
        <label>Código de verificación</label>
        <input type="text" name="token" class="form-control" placeholder="Ingresa el código" required />
    </div>

    <button type="submit" class="btn btn-primary">Verificar</button>
</form>
