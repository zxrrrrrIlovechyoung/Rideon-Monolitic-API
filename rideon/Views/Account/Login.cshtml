@model rideon.Models.UsuUsuario
@{
    ViewData["Title"] = "Iniciar Sesión - RideOn";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

    <div class="login-background">
        <div class="login-container">
            <h1 class="login-title">RideOn</h1>
            <p class="login-subtitle">Más que una moto, un sentimiento</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Error</div>
            }

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-success text-center">@ViewBag.Mensaje</div>
            }

           
            <form asp-action="Login" asp-controller="Account" method="post" class="login-form">
                @Html.AntiForgeryToken()

                <input asp-for="strCorreo" placeholder="Correo" class="login-input" required />
                <span asp-validation-for="strCorreo" class="text-danger"></span>

             
                <input asp-for="strContrasena" placeholder="Contraseña" type="password" class="login-input" required />
                <span asp-validation-for="strContrasena" class="text-danger"></span>

                <button type="submit" class="btn-gradient mt-3">Iniciar Sesión</button>
                <p class="mt-3 text-center">
    <a asp-controller="Account" asp-action="Recuperar" class="register-link">
        ¿Olvidaste tu contraseña?
    </a>
</p>

            </form>

            <p class="register-text mt-3">
                ¿No tienes cuenta?
                <a asp-controller="Account" asp-action="Register" class="register-link">Crea tu cuenta aquí</a>
           
               
            </p>

            <div class="qr-section d-flex align-items-center justify-content-center mt-4">
                <div id="qrcode"></div>
                <div class="qr-text ms-3">
                    <p>Escanea el código QR para descargar la app</p>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrcode"), {
            text: "http://rideoncompany.runasp.net/Account/DescargarApp",
            width: 120,
            height: 120
        });
    </script>
    <style>
        .qr-section {
            display: flex;
            align-items: center;
           
            gap: 20px;
        }

        .qr-text p {
            margin: 0;
            font-size: 0.9rem;
            color: #333;
        }
    </style>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
