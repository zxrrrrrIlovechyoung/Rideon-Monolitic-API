@{
    ViewData["Title"] = "Verificar código";
}

<h3>Ingresa el código enviado a tu correo</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="VerificarCodigo" method="post">
    <input type="hidden" name="correo" value="@ViewBag.Correo" />

    <label>Código</label>
    <input class="form-control" name="token" maxlength="6" required />

    <button class="btn btn-primary mt-3">Continuar</button>
</form>
