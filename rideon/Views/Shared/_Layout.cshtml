<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RideOn</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rideon.css" asp-append-version="true" />
</head>

<body>
    @inject IHttpContextAccessor HttpContextAccessor

    @{
        var usuarioNombre = HttpContextAccessor?.HttpContext?.Session.GetString("UsuarioNombre");
        var tipoUsuario = HttpContextAccessor?.HttpContext?.Session.GetInt32("TipoUsuario");
     
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RideOn</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (!string.IsNullOrEmpty(usuarioNombre))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                            </li>

                            @* Solo menú admin para TipoUsuario == 1 *@
                            @if (tipoUsuario.HasValue && tipoUsuario.Value == 1)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="UsuUsuarios" asp-action="Index">Usuarios</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="CatTipoUsuarios" asp-action="Index">Tipo de Usuarios</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="UsuCatSexoes">Sexo</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="CatMantenimientoes" asp-action="Index">Mantenimientos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="CatMotoes" asp-action="Index">Motos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="CatMarcaMotoes" asp-action="Index">Marcas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="CatRecomendacionesMotoes" asp-action="Index">Recomendaciones</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="UsuMantenimientoes" asp-action="Index">Mantenimiento de usuario</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Cerrar Sesión</a>
                            </li>
                        </ul>

                        <span class="navbar-text">
                            Bienvenido, @usuarioNombre
                        </span>
                    }
                    else
                    {
                        <span class="navbar-text">
                            No has iniciado sesión
                        </span>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - RideOn - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script>
        window.history.forward();
        window.onload = function() { window.history.forward(); };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
