@model rideon.Models.CatRecomendacionesMoto

@{
    ViewData["Title"] = "Crear Recomendación";
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @ViewBag.ErrorMessage
    </div>
}

<h1 class="mb-4">Crear Recomendación</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Moto -->
            <div class="form-group">
                <label asp-for="idMoto" class="control-label"></label>
                <select asp-for="idMoto" class="form-control" asp-items="ViewBag.idMoto"></select>
                <span asp-validation-for="idMoto" class="text-danger"></span>
            </div>


            <!-- Titulo -->
            <div class="form-group mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej: Cambio de aceite" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <!-- Descripcion -->
            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"
                          placeholder="Ej: Se recomienda realizar el cambio de aceite sintético..."></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <!-- Km recomendado -->
            <div class="form-group mb-3">
                <label asp-for="KmRecomendado" class="form-label"></label>
                <input asp-for="KmRecomendado" class="form-control" placeholder="Ej: 5000" />
                <span asp-validation-for="KmRecomendado" class="text-danger"></span>
            </div>

            <!-- Botón -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Crear</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Regresar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
