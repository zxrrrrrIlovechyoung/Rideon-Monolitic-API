@model rideon.Models.UsuMantenimiento

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles del Mantenimiento</h1>

<div>
    <h4>UsuMantenimiento</h4>
    <hr />
    <dl class="row">
        <!-- Usuario -->
        <dt class="col-sm-2">
            Usuario
        </dt>
        <dd class="col-sm-10">
            @Model.Usuario.strNombre
        </dd>

        <!-- Moto -->
        <dt class="col-sm-2">
            Moto
        </dt>
        <dd class="col-sm-10">
            @Model.Moto.CatMoto.CatMarcaMoto?.strMarca - @Model.Moto.CatMoto?.strModelo
        </dd>

        <!-- CatMantenimiento -->
        <dt class="col-sm-2">
            Mantenimiento
        </dt>
        <dd class="col-sm-10">
            @Model.CatMantenimiento.Nombre
        </dd>

        <!-- Fecha -->
        <dt class="col-sm-2">
            Fecha
        </dt>
        <dd class="col-sm-10">
            @Model.dtFecha.ToString("dd/MM/yyyy")
        </dd>

        <!-- Notas -->
        <dt class="col-sm-2">
            Notas
        </dt>
        <dd class="col-sm-10">
            @Model.strNotas
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.idMantenimientoUsuario">Editar</a> |
    <a asp-action="Index">Volver al listado</a>
</div>
