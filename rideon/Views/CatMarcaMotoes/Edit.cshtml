@model rideon.Models.CatMarcaMoto

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar Marca</h1>

<h4>CatMarcaMoto</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="idMarca" />

            <div class="form-group mb-3">
                <label asp-for="strMarca" class="control-label"></label>
                <input asp-for="strMarca" class="form-control" />
                <span asp-validation-for="strMarca" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
