@model rideon.Models.CatMarcaMoto

@{
    ViewData["Title"] = "Crear Marca";
}

<h1 class="mb-4">Registrar nueva marca</h1>

<h4>CatMarcaMoto</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Campo Marca -->
            <div class="form-group mb-3">
                <label asp-for="strMarca" class="control-label fw-semibold">Nombre de la marca</label>
                <input asp-for="strMarca" class="form-control" />
                <span asp-validation-for="strMarca" class="text-danger"></span>
            </div>

            <!-- Botón Crear -->
            <div class="form-group">
                <input type="submit" value="Registrar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<!-- Volver al índice -->
<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
