@model rideon.Models.CatMarcaMoto

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles de la Marca</h1>

<div class="card p-4 mt-3" style="max-width: 450px;">
    <h4>CatMarcaMoto</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.idMarca)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.idMarca)
        </dd>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.strMarca)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.strMarca)
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.idMarca">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Regresar</a>
</div>
