@model rideon.Models.CatTipoUsuario

@{
    ViewData["Title"] = "Crear Tipo de Usuario";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/rideon.css" />

<div class="registro-background">
    <div class="registro-container">
        <h1 class="registro-logo mb-2">RideOn</h1>
        <p class="registro-subtitle">Gestión de Tipos de Usuario</p>
        <h2 class="registro-bienvenida mb-4">Crear Tipo de Usuario</h2>

        <form asp-action="Create" method="post" class="registro-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="strDescripcion" class="form-label">Descripción</label>
                <input asp-for="strDescripcion" class="registro-input" />
                <span asp-validation-for="strDescripcion" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-3">
                <input type="submit" value="Crear" class="btn-gradient w-50" />
                <a asp-action="Index" class="btn btn-secondary w-50">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
