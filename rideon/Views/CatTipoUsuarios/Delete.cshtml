@model rideon.Models.CatTipoUsuario

@{
    ViewData["Title"] = "Eliminar Tipo de Usuario";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/rideon.css" />

<div class="container my-5 rideon-container">
    <h1 class="rideon-title mb-4">Eliminar Tipo de Usuario</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5>¿Está seguro que desea eliminar este registro?</h5>
            <dl class="row mt-3">
                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.strDescripcion)</dd>
            </dl>

            <div class="mt-4 d-flex gap-2">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="idTipoUsuario" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </div>
    </div>
</div>
